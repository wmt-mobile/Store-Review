# Review Radar — environment variables
# Production values live in Vercel → Project store-review → Settings → Environment Variables.
# Locally: copy to .env and fill in. See docs/02-configuration.md for every variable.

# ── Supabase (server only — never expose) ───────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# 32 random bytes, base64. Encrypts stored keys/tokens. NEVER change or lose it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Dashboard login (Supabase Auth) ─────────────────────────────────────
# Comma-separated emails allowed to sign in. Users are created in Supabase → Authentication.
AUTH_ALLOWED_EMAILS=mobile@webmobtech.com

# ── Google Chat ─────────────────────────────────────────────────────────
# Fixed space (spaces/AAAA… or the space link). When set, the dashboard cannot change it.
GOOGLE_CHAT_SPACE=

# ── Scheduling (Vercel + Supabase pg_cron) ──────────────────────────────
# Bearer token for POST /api/cron/tick — must equal the Supabase Vault secret review_radar_cron_secret.
CRON_SECRET=
# Public URL of the deployment (used for Google OAuth redirects)
PUBLIC_BASE_URL=https://store-review-eosin.vercel.app

# ── Display ─────────────────────────────────────────────────────────────
TZ_DISPLAY=Asia/Kolkata
# Protects GET /status?token=…
STATUS_TOKEN=

# ── Defaults (the dashboard's Setup page overrides these) ───────────────
APPLE_POLL_MINUTES=1
PLAY_POLL_MINUTES=2
GMAIL_POLL_MINUTES=1
DISCOVERY_HOURS=6
STUCK_HOURS=48
SILENT_FIRST_RUN=true
DIGEST_ENABLED=false
# Gmail search for Play Console emails (Setup → Play email reader → Search filter overrides it)
GMAIL_QUERY="from:(google.com) (subject:\"Google Play\" OR from:googleplay-noreply@google.com OR from:no-reply-googleplay-developer@google.com) newer_than:14d"

# ── Local only ──────────────────────────────────────────────────────────
PORT=8080
# HOST=127.0.0.1
# true = serve the dashboard without polling (use this while Vercel is live → no duplicate Chat posts)
NO_SCHEDULER=true
# DEMO_DATA=true   # fake data, no keys needed

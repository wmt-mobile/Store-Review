# ── Server ────────────────────────────────────────────────
PORT=8080
TZ_DISPLAY=Asia/Kolkata
# Public HTTPS URL (only needed for Apple webhooks)
PUBLIC_BASE_URL=
# Protects /status, /dashboard and /api/dashboard
STATUS_TOKEN=change-me-long-random
DASHBOARD_TOKEN=change-me-long-random
# Load fake data into the dashboard (no keys needed)
DEMO_DATA=false

# ── Google Chat ───────────────────────────────────────────
GOOGLE_CHAT_WEBHOOK_URL=

# ── Behaviour ─────────────────────────────────────────────
SILENT_FIRST_RUN=true
APPLE_POLL_MINUTES=5
PLAY_POLL_MINUTES=15
GMAIL_POLL_MINUTES=5
DISCOVERY_HOURS=6
DIGEST_ENABLED=true
# 24h HH:MM in TZ_DISPLAY
DIGEST_TIME=10:00
STUCK_HOURS=48

# ── Apple webhook secrets (one per apple account id in apps.json) ──
# APPLE_WEBHOOK_SECRET_<ACCOUNT_ID_UPPERCASE>=...
APPLE_WEBHOOK_SECRET_MAIN=

# ── Gmail (Play approvals / rejections) ───────────────────
# Option A – OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Option B – Workspace domain-wide delegation
GMAIL_SERVICE_ACCOUNT_PATH=
GMAIL_IMPERSONATE=
GMAIL_QUERY=from:(google.com) (subject:"Google Play" OR from:googleplay-noreply@google.com OR from:no-reply-googleplay-developer@google.com) newer_than:14d

# Fixed Google Chat space (spaces/AAAA… or the space link). When set, the dashboard cannot change it.
GOOGLE_CHAT_SPACE=

# Dashboard login: Supabase Auth users allowed to sign in (comma-separated). Empty = any confirmed Supabase user.
AUTH_ALLOWED_EMAILS=

# Secret for /api/cron/tick (Supabase pg_cron sends it as a Bearer token)
CRON_SECRET=

{
  "name": "store-review-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "App Store / TestFlight / Google Play review status -> Google Chat, plus a live review dashboard",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "demo": "DEMO_DATA=true node src/index.js",
    "check": "node scripts/check.js",
    "digest": "node scripts/digest-now.js",
    "gmail:auth": "node scripts/gmail-auth.js",
    "apple:webhooks": "node scripts/register-apple-webhooks.js",
    "test": "node --test test/*.test.js",
    "build": "vite build && node scripts/embed-spa.mjs",
    "dev:web": "vite",
    "vercel-build": "vite build && node scripts/embed-spa.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.7",
    "@vercel/functions": "2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "jose": "^5.9.6",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.0.9",
    "@vitejs/plugin-react": "4.3.4",
    "playwright-core": "1.48.2",
    "tailwindcss": "4.0.9",
    "vite": "5.4.11"
  }
}
